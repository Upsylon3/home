# Dependencies — reinstalled via `npm install` (or the root workspace
# install), never committed.
node_modules/

# Vite/production build output — regenerated by `npm run build`.
dist/

# Local environment files — contain secrets (JWT_SECRET etc). Copy the
# matching .env.example instead of committing real values.
.env
homecore/.env
apps/homecloud-backend/.env
apps/homemedia-backend/.env
apps/homenotes-backend/.env
apps/homesync-backend/.env
apps/homevault-backend/.env

# Per-service SQLite data directories — local runtime state, not source.
homecore/data/
apps/homecloud-backend/data/
apps/homemedia-backend/data/
apps/homenotes-backend/data/
apps/homesync-backend/data/
apps/homevault-backend/data/

# Nightly backup archives land here on the host (see services/backup).
# Keep the folder in git (so a fresh checkout has somewhere for the
# backup container to write) but ignore its contents.
backups/*
!backups/.gitkeep

*.log
.DS_Store

# Android (apps/homesync-android/) — standard Gradle/Android Studio build
# artifacts and machine-local config; none of this belongs in version
# control.
apps/homesync-android/.gradle/
apps/homesync-android/build/
apps/homesync-android/app/build/
apps/homesync-android/local.properties
apps/homesync-android/.idea/
apps/homesync-android/*.iml
apps/homesync-android/app/*.iml
