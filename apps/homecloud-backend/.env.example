# Copy this file to .env and change the values before running in production.
# Only needed if you're running this service directly (`npm run dev`)
# outside Docker Compose — the Docker setup sets these via
# docker-compose.yml's `environment:` block instead, and shares
# HOMECORE_INTERNAL_SECRET from homecore/.env so both services agree on it.

# Port this service's API listens on.
PORT=4500

# Where uploaded files and this service's own SQLite database (files,
# folders, share links) are stored inside the container. Docker users:
# leave this as /data — it must match the volume mount in
# docker-compose.yml (homecloud_backend_data:/data).
DATA_DIR=/data

# Comma-separated list of origins allowed to call this API directly.
# Only needed if you run a frontend dev server separately from Docker
# Compose. The production docker-compose setup proxies through nginx, so
# this can stay as-is.
CORS_ORIGIN=http://localhost:5173

# Default per-user storage quota, in bytes (5 GB below) — actually
# enforced here on every upload. Set this to the SAME value as
# homecore/.env's own QUOTA_BYTES, which only uses it to show/edit the
# right default in the admin panel; nothing keeps the two in sync
# automatically.
QUOTA_BYTES=5368709120

# How many days a deleted file stays recoverable in Trash before being
# permanently purged by the daily sweep (see src/server.js).
TRASH_RETENTION_DAYS=30

# Where to reach HomeCore for authentication — every request here is
# verified by asking HomeCore "who is this token?" (see
# @home/homecore-client), since this service has no identity of its own.
HOMECORE_INTERNAL_URL=http://homecore:4000

# Must exactly match HomeCore's own HOMECORE_INTERNAL_SECRET (see
# homecore/.env.example) — used to authenticate this service's own calls
# into HomeCore's event bus (POST /internal/events) so upload/delete/share
# actions show up in the shared activity feed.
HOMECORE_INTERNAL_SECRET=change_this_to_a_long_random_string
