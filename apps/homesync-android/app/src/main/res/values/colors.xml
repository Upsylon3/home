<resources>
    <!-- Matches ui/theme/Color.kt's LightBg — used only for the brief
         window background before Compose's first frame draws, so it
         should match whichever theme Compose is about to resolve to
         (isSystemInDarkTheme() → the same system day/night signal this
         resource qualifier already follows). The values-night/ variant
         below covers the dark case. -->
    <color name="window_background">#F3E9D2</color>
