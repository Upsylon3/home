# Copy this file to .env and change the values before running in production.
# Only needed if you're running this service directly (`npm run dev`)
# outside Docker Compose.

# Port this service's API listens on.
PORT=4600

# Where this service's own SQLite database (wrapped vault keys and
# encrypted item blobs — never plaintext) is stored inside the container.
# Docker users: leave this as /data — it must match the volume mount in
# docker-compose.yml (homevault_data:/data).
DATA_DIR=/data

# Comma-separated list of origins allowed to call this API directly.
# Only needed if you run a frontend dev server separately from Docker
# Compose. The production docker-compose setup proxies through nginx, so
# this can stay as-is.
CORS_ORIGIN=http://localhost:5177

# Where to reach HomeCore for authentication — every request here is
# verified by asking HomeCore "who is this token?" (see
# @home/homecore-client), since this service has no identity of its own.
HOMECORE_INTERNAL_URL=http://homecore:4000
