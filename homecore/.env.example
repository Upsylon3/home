# Copy this file to .env and change the values before running in production.

# Port the API server listens on inside the container.
# Docker users: leave this as 4000 — docker-compose.yml's healthcheck and
# internal networking both hardcode this port, so changing it here alone
# will break the container without any obvious error message. This only
# matters to change if you're running the backend directly with `npm run
# dev` (Path B in the README) and port 4000 is already taken on your machine.
PORT=4000

# Secret used to sign JWT auth tokens.
# CHANGE THIS to a long random string in production.
# You can generate one with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_long_random_string

# How long an auth token stays valid
JWT_EXPIRES_IN=7d

# Default per-user storage quota, in bytes. Default below is 5 GB.
# Actual quota enforcement happens in apps/homecloud-backend (see its own
# .env.example) — HomeCore only reads this to show/edit the right default
# in the admin panel. Set it to the SAME value in both places; nothing
# keeps them in sync automatically.
QUOTA_BYTES=5368709120

# Comma-separated list of origins allowed to call the API directly.
# Only needed if you run the frontend dev server separately from Docker Compose.
# The production docker-compose setup proxies through nginx, so this can stay as-is.
CORS_ORIGIN=http://localhost:5173

# Where HomeCore's own SQLite database (users, sessions, the app registry)
# is stored inside the container. Docker users: leave this as /data — it
# must match the volume mount in docker-compose.yml (homecore_data:/data),
# or your accounts and sessions will silently stop persisting between
# restarts. This is identity/session data only — actual files live in
# apps/homecloud-backend's own volume, not here.
DATA_DIR=/data

# Shared secret for POST /internal/events — the machine-to-machine endpoint
# apps/homecloud-backend calls to emit into HomeCore's event bus (it has no
# other way to reach HomeCore's activity feed, since the two are separate
# processes). NOT a per-user credential. The exact same value must also be
# set as HOMECORE_INTERNAL_SECRET wherever apps/homecloud-backend runs —
# docker-compose.yml already does this by having both services share this
# same .env file. CHANGE THIS to a long random string in production, same
# as JWT_SECRET.
HOMECORE_INTERNAL_SECRET=change_this_to_a_long_random_string
